{
  "schema": 1,
  "fixture": "Gameplay from a disposable normal-mode save with at least one weapon and unlocked Camera/Album/Compendium. No purchases or saves.",
  "steps": [
    {
      "name": "Open Inventory from gameplay (setup key)",
      "when": {
        "gameplay": 1,
        "menu_presented": 0
      },
      "key": "Plus",
      "expect": {
        "mode": "inventory",
        "active": 1
      }
    },
    {
      "name": "Inventory item opens its action list",
      "when": {
        "mode": "inventory",
        "active": 1
      },
      "tap": {
        "kind": "slot",
        "path_suffix": "/Pa_Btn_00/N_Born_00/B_Hit_00"
      },
      "expect": {
        "mode": "popup",
        "active": 1
      }
    },
    {
      "name": "Item popup Back returns to inventory",
      "when": {
        "mode": "popup",
        "active": 1
      },
      "tap": {
        "kind": "back"
      },
      "expect": {
        "mode": "inventory",
        "active": 1
      }
    },
    {
      "name": "R hint opens the System tab",
      "when": {
        "mode": "inventory",
        "active": 1
      },
      "tap": {
        "kind": "hint",
        "button": 128
      },
      "expect": {
        "screen": "PauseMenu_00",
        "mode": "generic",
        "active": 1,
        "target": {
          "path_contains": "N_Slide_02"
        }
      }
    },
    {
      "name": "System Options opens by direct touch",
      "when": {
        "screen": "PauseMenu_00",
        "mode": "generic",
        "active": 1
      },
      "tap": {
        "kind": "target",
        "path_suffix": "/Pa_Btn_02/B_Hit_00"
      },
      "expect": {
        "screen": "OptionWindow_00",
        "active": 1
      }
    },
    {
      "name": "Options Back returns to System",
      "when": {
        "screen": "OptionWindow_00",
        "active": 1
      },
      "tap": {
        "kind": "back"
      },
      "expect": {
        "screen": "PauseMenu_00",
        "active": 1,
        "target": {
          "path_contains": "N_Slide_02"
        }
      }
    },
    {
      "name": "System DLC button opens the content page",
      "when": {
        "screen": "PauseMenu_00",
        "mode": "generic",
        "active": 1
      },
      "tap": {
        "kind": "target",
        "path_suffix": "/Pa_Btn_04/B_Hit_00"
      },
      "expect": {
        "screen": "DLCWindow_00",
        "active": 1
      }
    },
    {
      "name": "DLC Back returns to System",
      "when": {
        "screen": "DLCWindow_00",
        "active": 1
      },
      "tap": {
        "kind": "back"
      },
      "expect": {
        "screen": "PauseMenu_00",
        "mode": "generic",
        "active": 1,
        "target": {
          "path_contains": "N_Slide_02"
        }
      }
    },
    {
      "name": "System Back restores gameplay",
      "when": {
        "screen": "PauseMenu_00",
        "mode": "generic",
        "active": 1
      },
      "tap": {
        "kind": "back"
      },
      "expect": {
        "gameplay": 1,
        "menu_presented": 0,
        "active": 0
      }
    },
    {
      "name": "Open Slate map (setup key)",
      "when": {
        "gameplay": 1,
        "menu_presented": 0
      },
      "key": "Minus",
      "expect": {
        "mode": "map",
        "active": 1
      }
    },
    {
      "name": "Map R hint opens Album",
      "when": {
        "screen": "AppMap_00",
        "mode": "map",
        "active": 1
      },
      "tap": {
        "kind": "hint",
        "button": 128
      },
      "expect": {
        "screen": "AppAlbum_00",
        "active": 1
      }
    },
    {
      "name": "Album R hint opens Compendium",
      "when": {
        "screen": "AppAlbum_00",
        "active": 1
      },
      "tap": {
        "kind": "hint",
        "button": 128
      },
      "expect": {
        "screen": "AppPictureBook_00",
        "active": 1
      }
    },
    {
      "name": "Compendium L hint returns to Album",
      "when": {
        "screen": "AppPictureBook_00",
        "active": 1
      },
      "tap": {
        "kind": "hint",
        "button": 64
      },
      "expect": {
        "screen": "AppAlbum_00",
        "active": 1
      }
    },
    {
      "name": "Album L hint returns to Map",
      "when": {
        "screen": "AppAlbum_00",
        "active": 1
      },
      "tap": {
        "kind": "hint",
        "button": 64
      },
      "expect": {
        "screen": "AppMap_00",
        "mode": "map",
        "active": 1
      }
    },
    {
      "name": "Map Back restores gameplay",
      "when": {
        "screen": "AppMap_00",
        "mode": "map",
        "active": 1
      },
      "tap": {
        "kind": "back"
      },
      "expect": {
        "gameplay": 1,
        "menu_presented": 0,
        "active": 0
      }
    }
  ]
}
